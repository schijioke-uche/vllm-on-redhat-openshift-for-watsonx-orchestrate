#                    U  S  E  R     --     D  E  F I N E D


#-------------------------------------------------------------------------------
START_TIME=$(date +%s)
CHOICE_CODE=200
THIS_DAY=$(date +"%B %d, %Y, %-I:%M %P %Z")
#------------------------------------------------------------------------------

OCP_URL=https://api.your-cluster.example.com:6443
OCP_TOKEN=sha256~replace-me

# Optional, recommended when deploying private or gated Hugging Face models
HF_TOKEN=hf_replace_me

# Optional namespace. If omitted, the script derives one from the model ID.
# NAMESPACE=my-vllm-namespace

# For registry.redhat.io base images used by ppc64le and s390x.
# If a rh-registry-pull secret already exists in the namespace, these are optional.
RH_REGISTRY_USERNAME=replace-me
RH_REGISTRY_PASSWORD=replace-me
RH_REGISTRY_EMAIL=unused@example.com

# TLS option for lab clusters with self-signed API certificates.
OCP_INSECURE_SKIP_TLS_VERIFY=false

# Runtime tuning:
CPU_REQUEST=4
CPU_LIMIT=8
MEMORY_REQUEST=16Gi
MEMORY_LIMIT=64Gi
PVC_SIZE=200Gi
SHM_SIZE=8Gi
MAX_MODEL_LEN=4096
DTYPE=auto
VLLM_CPU_KVCACHE_SPACE=8
EXTRA_VLLM_ARGS=

# Optional base image overrides
# BASE_IMAGE_AMD64=docker.io/vllm/vllm-openai-cpu:v0.22.0-x86_64
# BASE_IMAGE_ARM64=docker.io/vllm/vllm-openai-cpu:v0.22.0-arm64
# BASE_IMAGE_PPC64LE=registry.redhat.io/rhaiis/vllm-spyre-rhel9:3.3.0
# BASE_IMAGE_S390X=registry.redhat.io/rhaiis/vllm-spyre-rhel9:3.3.0
